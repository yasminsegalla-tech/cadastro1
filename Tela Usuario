    private void btnCadastrarActionPerformed(java.awt.event.ActionEvent evt) {                                             
        // botao cadastro
        if(txtUsuario.getText().isEmpty()|| txtSenhaUsuario.getText().isEmpty() ) {
            JOptionPane.showMessageDialog(null, "Campo Usuário ou senha vazio");
        }else{
              JOptionPane.showMessageDialog(null, "Cadastro realizado com sucesso");
              telaLogin acesso = new telaLogin();
              acesso.setExtendedState(MAXIMIZED_BOTH);
              acesso.setVisible(true);
              this.dispose();
        }
    }                                            

